{
  "version": 2,
  "builds": [
    { "src": "pronostat/wsgi.py", "use": "@vercel/python" },
    { "src": "build_files.sh", "use": "@vercel/static-build", "config": { "distDir": "staticfiles_build" } }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "/manifest.json", "dest": "/static/manifest.json" },
    { "src": "/service-worker.js", "dest": "/static/service-worker.js" },
    { "src": "/(.*)", "dest": "pronostat/wsgi.py" }
  ]
}
